# CareCircle Environment Configuration Example

# 1. Groq Vision AI Configuration (Prescription & Report Extraction)
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b


# 2. Resend Transactional Email Provider
# onboarding@resend.dev only delivers to your own Resend account email.
# Verify a domain in Resend and use an address on it so real users get emails.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=CareCircle <no-reply@your-verified-domain.com>

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Razorpay (placeholder values = local sandbox under `next dev` only;
#    production refuses payments until real keys + plan ids are set)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_demo123456
RAZORPAY_KEY_ID=rzp_test_demo123456
RAZORPAY_KEY_SECRET=demo_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=demo_webhook_secret_key
RAZORPAY_PLAN_ID_FAMILY=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_EXTENDED=plan_xxxxxxxxxxxxxx

# 4b. Google Sign-In (Google Identity Services). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 5. Supabase PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE


# 6. Sarvam Voice Agents (Saathi calls). Calling stays OFF until all of these are set.
#    See docs/sarvam-agent.md. Find org/workspace ids in the Sarvam dashboard URL.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=+91XXXXXXXXXX
# Secret for the end-of-call webhook (?token=) and the escalation tool (Bearer). Generate: openssl rand -hex 24
SARVAM_WEBHOOK_SECRET=
# NEXT_PUBLIC_APP_URL (above) must be the PUBLIC https URL Sarvam can reach.

# 7. Cron secret. An external scheduler calls POST/GET /api/cron/dispatch every ~5 minutes
#    with header `x-cron-secret: <CRON_SECRET>` (or `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=your_random_long_secret_here
