# CareCircle Environment Configuration Example

# 1. Groq Vision AI Configuration (Prescription & Report Extraction)
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# 1b. Groq Saathi AI Calling Model
GROQ_CALL_MODEL=openai/gpt-oss-120b

# 2. Resend Transactional Email Provider
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=CareCircle <onboarding@resend.dev>

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Razorpay Gateway Keys (Demo / Sandbox)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_demo123456
RAZORPAY_KEY_SECRET=demo_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=demo_webhook_secret_key

# 5. Supabase PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# 6. Twilio — Saathi AI Voice Calls
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# 7. Cron secret (used by scheduled call trigger)
CRON_SECRET=your_random_long_secret_here
